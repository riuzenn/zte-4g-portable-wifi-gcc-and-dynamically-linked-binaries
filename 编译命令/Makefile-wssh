export TOOLCHAIN=${HOME}/usr
export CROSS_COMPILE=${TOOLCHAIN}/bin/arm-buildroot-linux-uclibcgnueabi-
export SYSROOT=${TOOLCHAIN}/arm-buildroot-linux-uclibcgnueabi/sysroot
export ZTE_LIB=${HOME}/ztelib

export CC="${CROSS_COMPILE}gcc"
export STRIP="${CROSS_COMPILE}strip"

export CFLAGS="-Wextra -Os -mcpu=cortex-a53 -mtune=cortex-a53 -mfloat-abi=soft -mthumb -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-ident -fomit-frame-pointer -ffunction-sections -fdata-sections -fvisibility=hidden --sysroot=${SYSROOT} -fno-pie -fno-stack-protector -fno-align-functions -fno-align-loops -fno-align-jumps -fno-align-labels -fmerge-all-constants -fno-common"

export LDFLAGS="-mcpu=cortex-a53 -mtune=cortex-a53 -Wl,--as-needed -Wl,--no-copy-dt-needed-entries -L${ZTE_LIB} -Wl,-rpath-link=${ZTE_LIB} -Wl,-O2 -Wl,--gc-sections -Wl,-dynamic-linker,/lib/ld-uClibc.so.0 -Wl,-z,max-page-size=4096 -Wl,--no-undefined -Wl,--no-allow-shlib-undefined -Wl,-z,norelro -Wl,-z,lazy -Wl,-t -Wl,--build-id=none"

export LIBS=""

${CC} ${CFLAGS} wssh.c -o wssh ${LDFLAGS} ${LIBS}

ls -l wssh
file wssh
readelf -h wssh
readelf -A wssh
readelf -d wssh | grep NEEDED
readelf -h wssh | grep Type
readelf -l wssh | grep GNU_RELRO
readelf -d wssh | grep BIND_NOW
readelf -s wssh | grep stack_chk
readelf -r wssh | grep stack_chk
readelf -l wssh | grep GNU_STACK

${STRIP} --strip-all -R .note -R .comment -R .gnu_debuglink -R .gnu_debugdata wssh
~/ELFkickers/sstrip/sstrip wssh
ls -l wssh

