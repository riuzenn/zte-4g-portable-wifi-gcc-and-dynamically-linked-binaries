cd ~
wget https://musl.cc/arm-linux-musleabi-cross.tgz
tar -xzf arm-linux-musleabi-cross.tgz

wget https://www.tip.net.au/~dbell/programs/sash-3.8.tar.gz
tar -xzf sash-3.8.tar.gz
mv sash-3.8 sash_build
cd ~/sash_build

make clean
export TOOLCHAIN=${HOME}/arm-linux-musleabi-cross
export CROSS_COMPILE=${TOOLCHAIN}/bin/arm-linux-musleabi-

export CC="${CROSS_COMPILE}gcc"
export AR="${CROSS_COMPILE}gcc-ar"
export RANLIB="${CROSS_COMPILE}gcc-ranlib"
export STRIP="${CROSS_COMPILE}strip"

export CFLAGS="-Wextra -Os -mcpu=cortex-a53 -mtune=cortex-a53 -mfloat-abi=soft -mthumb -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-ident -fomit-frame-pointer -ffunction-sections -fdata-sections -fvisibility=hidden -fno-pie -fno-stack-protector -flto=$(nproc) -fno-align-functions -fno-align-loops -fno-align-jumps -fno-align-labels"

export LDFLAGS="-static -mcpu=cortex-a53 -mtune=cortex-a53 -Wl,--as-needed -Wl,--no-copy-dt-needed-entries -Wl,-O2 -Wl,--gc-sections -Wl,-z,max-page-size=4096 -Wl,--no-undefined -Wl,--no-allow-shlib-undefined -no-pie -Wl,-z,norelro -Wl,-z,lazy -Wl,-t -Wl,-Map,aaa.map -Wl,--build-id=none -flto=$(nproc)"

export LIBS=""

make V=1 -j$(nproc) > ~/1.txt 2>&1

${CROSS_COMPILE}size -A sash
${CROSS_COMPILE}size -A sash | grep -E '\.(text|rodata|bss)\b'
${CROSS_COMPILE}nm -S --size-sort sash

ls -l sash
file sash
readelf -d sash | grep NEEDED
readelf -h sash | grep Type
readelf -l sash | grep GNU_RELRO
readelf -d sash | grep BIND_NOW
readelf -s sash | grep stack_chk
readelf -r sash | grep stack_chk
readelf -l sash | grep GNU_STACK

${STRIP} --strip-all -R .note -R .comment -R .gnu_debuglink -R .gnu_debugdata sash
~/ELFkickers/sstrip/sstrip sash
ls -l sash
